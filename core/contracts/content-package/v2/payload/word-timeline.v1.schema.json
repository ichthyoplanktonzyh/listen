{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://listen.dev/contracts/content-package/v2/payload/word-timeline.v1.schema.json",
  "title": "Listen word_timeline payload v1",
  "description": "The v1 word timeline payload shape, reused verbatim in v2. References a subtitle_text_track anchor by sentence id and token index.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "words"
  ],
  "properties": {
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/wordTiming"
      }
    }
  },
  "$defs": {
    "wordTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sentence_id",
        "token_index",
        "start_ms",
        "end_ms",
        "timing_source"
      ],
      "properties": {
        "sentence_id": {
          "type": "string",
          "minLength": 1
        },
        "token_index": {
          "type": "integer",
          "minimum": 0
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "timing_source": {
          "enum": [
            "asr_reported",
            "asr_aligned",
            "forced_aligned",
            "estimated",
            "user_adjusted"
          ]
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
