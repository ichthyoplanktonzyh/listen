{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://listen.dev/contracts/content-package/v2/payload/phone-timeline.v1.schema.json",
  "title": "Listen phone_timeline payload v1",
  "description": "The v1 phone timeline payload shape, reused verbatim in v2. References a word_timeline anchor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phone_set",
    "precision",
    "phones"
  ],
  "properties": {
    "phone_set": {
      "type": "string",
      "minLength": 1
    },
    "precision": {
      "enum": [
        "detected",
        "aligned",
        "approximate"
      ]
    },
    "phones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phone"
      }
    }
  },
  "$defs": {
    "phone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "start_ms",
        "end_ms",
        "word_ref"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "display_ipa": {
          "type": "string",
          "minLength": 1
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "word_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/tokenRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "tokenRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sentence_id",
        "token_index"
      ],
      "properties": {
        "sentence_id": {
          "type": "string",
          "minLength": 1
        },
        "token_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
