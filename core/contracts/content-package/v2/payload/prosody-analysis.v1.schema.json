{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://listen.dev/contracts/content-package/v2/payload/prosody-analysis.v1.schema.json",
  "title": "Listen prosody_analysis payload v1",
  "description": "The v1 prosody analysis payload shape, reused verbatim in v2. References a word_timeline anchor. No English-only assumption is made.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchors"
  ],
  "properties": {
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sentence_id",
          "chunk_index",
          "start_token_index",
          "end_token_index_exclusive",
          "confidence"
        ],
        "properties": {
          "sentence_id": {
            "type": "string",
            "minLength": 1
          },
          "chunk_index": {
            "type": "integer",
            "minimum": 0
          },
          "start_token_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_token_index_exclusive": {
            "type": "integer",
            "minimum": 1
          },
          "nucleus_token_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      }
    }
  },
  "$defs": {
    "tokenRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sentence_id",
        "token_index"
      ],
      "properties": {
        "sentence_id": {
          "type": "string",
          "minLength": 1
        },
        "token_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word_ref",
        "lexical_stress",
        "realized_prominence",
        "utterance_role",
        "evidence",
        "confidence"
      ],
      "properties": {
        "word_ref": {
          "$ref": "#/$defs/tokenRef"
        },
        "syllable_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "lexical_stress": {
          "enum": [
            "primary",
            "secondary",
            "unstressed",
            "unknown"
          ]
        },
        "realized_prominence": {
          "$ref": "#/$defs/confidence"
        },
        "utterance_role": {
          "enum": [
            "nucleus",
            "prenuclear",
            "postnuclear",
            "unmarked",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "energy",
              "pitch",
              "duration",
              "lexical_stress",
              "context"
            ]
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    }
  }
}
