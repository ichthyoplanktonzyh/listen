{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://listen.dev/contracts/content-package/v2/payload/timed-text-track.v2.schema.json",
  "title": "Listen timed_text_track payload v2",
  "description": "A timed transcript with per-segment BCP47 language tags and half-open positive time spans. Segment indexes are contiguous. There is no package-wide media duration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "segments"
  ],
  "properties": {
    "language": {
      "$ref": "#/$defs/languageTag"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "language",
        "start_ms",
        "end_ms",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "language": {
          "$ref": "#/$defs/languageTag"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "object"
        }
      }
    }
  }
}
