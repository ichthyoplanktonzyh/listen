{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://listen.dev/contracts/content-package/v2/payload/translation.v1.schema.json",
  "title": "Listen translation payload v1",
  "description": "An assistance translation anchored to an exact Base Resource (base_resource_id) with an explicit support language. Each segment references a source segment id in the base resource payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "support_language",
    "base_resource_id",
    "segments"
  ],
  "properties": {
    "support_language": {
      "$ref": "#/$defs/languageTag"
    },
    "base_resource_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "text",
        "source_segment_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_segment_id": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "object"
        }
      }
    }
  }
}
