{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://listen.dev/contracts/content-package/v3/definitions.schema.json",
  "title": "Listen Content Package v3 shared definitions",
  "description": "Shareable definitions used by release.schema.json and resource.schema.json. Schema $id values are stable contract identifiers, not network locations that an importer must fetch.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "versionedProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "extensions": {
      "type": "object"
    },
    "blobDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "size_bytes", "embedded"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "embedded": { "type": "boolean" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at_ms", "tool"],
      "properties": {
        "created_at_ms": { "type": "integer", "minimum": 0 },
        "tool": { "$ref": "#/$defs/versionedProducer" },
        "provider": { "anyOf": [{ "$ref": "#/$defs/versionedProducer" }, { "type": "null" }] },
        "model": { "anyOf": [{ "$ref": "#/$defs/versionedProducer" }, { "type": "null" }] },
        "config_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "provenanceV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at_ms",
        "tool",
        "input_rendition_ids",
        "input_resource_ids",
        "extensions"
      ],
      "properties": {
        "created_at_ms": { "type": "integer", "minimum": 0 },
        "tool": { "$ref": "#/$defs/versionedProducer" },
        "provider": { "anyOf": [{ "$ref": "#/$defs/versionedProducer" }, { "type": "null" }] },
        "model": { "anyOf": [{ "$ref": "#/$defs/versionedProducer" }, { "type": "null" }] },
        "config_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "input_rendition_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" },
          "uniqueItems": true
        },
        "input_resource_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" },
          "uniqueItems": true
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_status", "warnings", "extensions"],
      "properties": {
        "review_status": {
          "type": "string",
          "enum": ["unreviewed", "machine_checked", "human_reviewed"]
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_inputs", "checks"],
      "properties": {
        "verified_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rendition_id"],
            "properties": {
              "rendition_id": { "$ref": "#/$defs/sha256" },
              "resource_id": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
            }
          },
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition_id", "title", "target_language", "support_languages"],
      "properties": {
        "edition_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "target_language": { "$ref": "#/$defs/languageTag" },
        "support_languages": {
          "type": "array",
          "items": { "$ref": "#/$defs/languageTag" },
          "uniqueItems": true
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id", "material_revision_id", "title"],
      "properties": {
        "material_id": { "type": "string", "minLength": 1 },
        "material_revision_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    }
  }
}
