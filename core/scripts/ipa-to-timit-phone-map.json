{
  "_comment": "IPA character → TIMIT phone mapping for vitouphy/fb-espeak wav2vec2 models",
  "_note": "The vitouphy model outputs individual IPA characters per frame (not multi-char phonemes like 'aʊ').",
  "_note2": "The fb-espeak model uses espeak IPA tokenizer, also outputs individual characters.",
  "phone_set_source": "ipa",
  "phone_set_target": "timit_phone",
  "_skip_tokens": ["|", " ", "[UNK]", "[PAD]", "<s>", "</s>"],
