    "ʌ": "ah",
    "ɔ": "ao",
    "ɔː": "ao",
    "ɒ": "aa",
    "ɒː": "aa",
    "ɚ": "axr",

    "aʊ": "aw",
    "aɪ": "ay",
    "ɔɪ": "oy",
    "eɪ": "ey",
    "oʊ": "ow",
    "əʊ": "ow",

    "b": "b",
    "ʧ": "ch",
    "d": "d",
